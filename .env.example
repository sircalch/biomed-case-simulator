# Public site identity
NEXT_PUBLIC_SITE_URL=https://biomed-case-simulator.vercel.app
NEXT_PUBLIC_CORE_URL=https://biomedtools-mx-core.vercel.app

# Public links to related BioMedTools MX modules
NEXT_PUBLIC_QUIZ_ARENA_URL=https://biomed-quiz-arena.vercel.app
NEXT_PUBLIC_REPORT_BUILDER_URL=https://clinical-report-builder.vercel.app
NEXT_PUBLIC_BIOMED_3D_LAB_URL=https://biomed-3d-engineering-lab.vercel.app

# Optional. Leave empty to hide donation UI.
NEXT_PUBLIC_DONATION_URL=

# Keep internal routes hidden in public deployments unless explicitly enabled.
NEXT_PUBLIC_SHOW_INTERNAL_NAV=false
INTERNAL_ROUTE_USER=
INTERNAL_ROUTE_PASSWORD=

# Optional Supabase persistence. Server-only values, never expose as NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CASE_RUNS_TABLE=simulation_runs
